NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://app:password@localhost:5432/appdb
JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-at-least-32-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
PUBLIC_POSITION_DECIMALS=3
LOCATION_RETENTION_DAYS=7
TRAFFIC_RETENTION_DAYS=90
TRAFFIC_MIN_USERS=3
SMTP_URL=smtp://localhost:1025
APP_BASE_URL=http://localhost:8081
